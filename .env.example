# Copy this file to `.env` and fill in values locally. `.env` is git-ignored.
# Never paste real keys into source code, issues, or chat.

# --- Application ---
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                # json | console

# Only "paper" is accepted. The app refuses to start with any other value.
TRADING_MODE=paper

# --- Market data (Alpaca Market Data API v2) ---
MARKET_DATA_PROVIDER=alpaca
# API key pair from your Alpaca dashboard. Leave blank to run without market data.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
# iex = free real-time feed (IEX exchange only). sip = consolidated tape (subscription
# required for recent data). delayed_sip = consolidated tape delayed 15 minutes.
ALPACA_DATA_FEED=iex
# Option quotes feed: indicative (free) or opra (subscription).
ALPACA_OPTIONS_FEED=indicative
ALPACA_TIMEOUT_SECONDS=10
ALPACA_MAX_RETRIES=3

# --- Database (PostgreSQL via `docker compose up -d`) ---
# Used by docker-compose.yml to create the database container.
POSTGRES_USER=marketintel
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=marketintel
POSTGRES_PORT=5432
# Used by the app and Alembic. Keep user/password/db/port in sync with the values above.
DATABASE_URL=postgresql+psycopg://marketintel:change-me-local-only@localhost:5432/marketintel
# Optional, for the database tests: the compose init script creates <POSTGRES_DB>_test.
# Its name MUST end in _test; tests delete all of its data.
TEST_DATABASE_URL=postgresql+psycopg://marketintel:change-me-local-only@localhost:5432/marketintel_test

# --- API security ---
# Bearer token for write endpoints (e.g. POST /market/bars/ingest). Leave blank to
# disable writes. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_WRITE_TOKEN=

# --- Optional AI explanations (Anthropic) ---
# Leave blank to use deterministic explanations only. Never commit a real key.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# --- AlphaScout (SEC EDGAR) ---
# Required for research: SEC asks every client to identify itself with a contact email,
# e.g. "Your Name your.email@example.com". Requests are kept under 10 per second.
SEC_USER_AGENT=
